{
  "manifest_version": 3,
  "name": "Cogentia Navigation Assistant",
  "version": "1.0.17",
  "description": "Outbound multi-tab bridge for the Cogentia navigation assistant.",
  "permissions": [
    "debugger",
    "tabs",
    "windows",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:8776/*",
    "http://127.0.0.1:18776/*",
    "ws://127.0.0.1:8765/*",
    "ws://127.0.0.1:8776/*",
    "ws://127.0.0.1:18776/*",
    "http://*/*",
    "https://*/*",
    "http://100.84.109.87:8776/*",
    "ws://100.84.109.87:8776/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-observe.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cogentia Navigation Assistant"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8765 ws://127.0.0.1:8776 ws://127.0.0.1:18776 ws://100.84.109.87:8776"
  }
}
