{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogentia.fractavolta.com/schemas/john.request.v1.schema.json",
  "title": "John headless request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "request_id", "principal", "mandate", "budget", "execution_budget", "exposure", "capability", "input", "handler"],
  "properties": {
    "version": { "const": "john.request.v1" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "principal": { "$ref": "#/$defs/identified" },
    "mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "budget": { "$ref": "#/$defs/identified" },
    "execution_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_steps", "max_tool_calls", "max_subagents", "max_elapsed_ms", "max_external_effects"],
      "properties": {
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_tool_calls": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "max_subagents": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "max_elapsed_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "max_external_effects": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "exposure": { "type": "string", "enum": ["none", "read_only", "bounded", "consequential"] },
    "capability": { "type": "string", "minLength": 1, "maxLength": 128 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": { "prompt": { "type": "string", "minLength": 1, "maxLength": 50000 } }
    },
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["mock"] }
      }
    },
    "ithaca": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "return_target": { "type": "string" },
        "response_channel": { "type": "string" },
        "return_conditions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "identified": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    }
  }
}
