{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JeanHuguesRobert/cogentia/trace/schemas/mail-artifact.schema.json",
  "title": "Cogentia Mail Artifact",
  "description": "A private, durable and referenceable observation that an email was received or sent.",
  "type": "object",
  "required": [
    "schema_version",
    "occurrence_id",
    "artifact_type",
    "artifact_id",
    "observed_at",
    "mail_from",
    "rcpt_to",
    "visibility",
    "integrity",
    "transport"
  ],
  "properties": {
    "schema_version": {
      "const": "cogentia.mail-artifact.v1"
    },
    "occurrence_id": {
      "type": "string",
      "pattern": "^urn:cogentia:mail-occurrence:[A-Za-z0-9._:-]+$",
      "description": "Durable identifier for this specific receive or send observation."
    },
    "artifact_type": {
      "type": "string",
      "enum": ["email_received", "email_sent"]
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^urn:cogentia:mail:sha256:[a-f0-9]{64}$",
      "description": "Content address derived from the exact preserved RFC 5322 message bytes."
    },
    "message_id": {
      "type": "string",
      "description": "Original Message-ID header used for correlation, never as the sole integrity identifier."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "declared_date": {
      "type": "string",
      "format": "date-time"
    },
    "mail_from": {
      "type": "string"
    },
    "header_from": {
      "type": "string"
    },
    "rcpt_to": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "direction": {
      "type": "string",
      "enum": ["inbound", "outbound", "internal"]
    },
    "agent_id": {
      "type": "string"
    },
    "parent_agent_id": {
      "type": "string"
    },
    "mandate_id": {
      "type": "string"
    },
    "action_request_id": {
      "type": "string"
    },
    "thread_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "visibility": {
      "type": "string",
      "enum": ["raw_private", "private", "restricted", "do_not_publish"]
    },
    "sensitivity": {
      "type": "array",
      "items": { "type": "string" }
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "raw_message_sha256", "raw_message_ref"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "raw_message_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_message_size": {
          "type": "integer",
          "minimum": 0
        },
        "raw_message_ref": {
          "type": "string",
          "description": "Private content-addressed storage reference; never a public URL."
        }
      },
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "properties": {
        "spf": { "type": "string", "enum": ["pass", "fail", "softfail", "neutral", "none", "temperror", "permerror", "not_checked"] },
        "dkim": { "type": "string", "enum": ["pass", "fail", "none", "temperror", "permerror", "not_checked"] },
        "dmarc": { "type": "string", "enum": ["pass", "fail", "none", "temperror", "permerror", "not_checked"] },
        "tls": { "type": "boolean" },
        "tls_version": { "type": "string" },
        "peer": { "type": "string" }
      },
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "required": ["stage", "status"],
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["smtp_accepted", "mailbox_stored", "submission_accepted", "relay_attempted", "remote_accepted", "delivery_failed"]
        },
        "status": {
          "type": "string",
          "enum": ["accepted", "stored", "sent", "delivered", "failed", "deferred"]
        },
        "smtp_reply": { "type": "string" },
        "queue_id": { "type": "string" },
        "provider_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "caused_by": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
