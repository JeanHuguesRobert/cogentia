{
  "version": "john.request.v1",
  "request_id": "case-001-incident-failover",
  "principal": {
    "id": "operium:incident-response"
  },
  "mandate": {
    "id": "mandate:incident:diagnosis",
    "version": "1.0.0"
  },
  "budget": {
    "id": "budget:incident:emergency"
  },
  "execution_budget": {
    "max_steps": 4,
    "max_tool_calls": 2,
    "max_subagents": 0,
    "max_elapsed_ms": 10000,
    "max_external_effects": 0
  },
  "exposure": "bounded",
  "capability": "john.research",
  "input": {
    "prompt": "Investigate elevated connection drop rate during failover and propose remedy."
  },
  "handler": {
    "id": "governed.step_reasoner",
    "kind": "governed_reasoner",
    "allowed_capabilities": [
      "corpus.search"
    ]
  },
  "ithaca": {
    "description": "Operium Incident Response Room (Ithaca)",
    "return_target": "operium-incident-channel",
    "response_channel": "incident-bus",
    "return_conditions": [
      "root-cause-identified"
    ]
  }
