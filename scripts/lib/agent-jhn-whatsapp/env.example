# Agent JHN WhatsApp MVP — example env (no secrets)
# Copy to a private location; never commit real JID session paths with credentials.

# Absolute private directory for session, outbox, traces, raw private payloads.
# Occam: use registre-mariani runtime (private registry), not a new ad-hoc home.
# Windows example:
AGENT_JHN_WHATSAPP_STATE_DIR=C:\tweesic\registre-mariani\runtime\agent-jhn-whatsapp

# Own WhatsApp JID only (self_chat_only). Example shape, not a real production id.
AGENT_JHN_WHATSAPP_ALLOWED_SELF_JID=336xxxxxxxx@s.whatsapp.net

# Mandatory experimental disclosure URL
AGENT_JHN_WHATSAPP_NOTICE_URL=https://github.com/JeanHuguesRobert/JeanHuguesRobert/blob/main/research/agent-jhn-experimental-notice.md

# Must remain self_chat_only for this MVP
AGENT_JHN_WHATSAPP_MODE=self_chat_only

# Material send OFF by default — enable only with explicit local decision
AGENT_JHN_WHATSAPP_SEND_ENABLED=false

# Optional dry-run force
# AGENT_JHN_WHATSAPP_DRY_RUN=false

# Usage grant controls (mediated capacity; not account transfer)
# AGENT_JHN_WHATSAPP_USAGE_GRANT_ID=jhn-whatsapp-self-chat-experimental-v1
# AGENT_JHN_WHATSAPP_BENEFICIARY_INSTANCE_ID=agent-jhn
# AGENT_JHN_WHATSAPP_GRANT_REVOKED=false
# AGENT_JHN_WHATSAPP_GRANT_EXPIRES_AT=

# Groups: leave disabled for first real test
# AGENT_JHN_WHATSAPP_GROUPS_ENABLED=false
# AGENT_JHN_WHATSAPP_GROUP_POLICIES_JSON=

# Persona must stay unset / null
# AGENT_JHN_WHATSAPP_PERSONA_ID=

# Cognitive retrieval for WhatsApp drafts (default: guide — reversible, safe)
# guide     — POST /guide/chat then OpenAI (website Guide reuse; current default)
# librarian — corpus librarian: Context Gateway tools → evidence packet → synth
# shadow    — live answer stays guide; librarian runs in parallel for compare only
# AGENT_JHN_WHATSAPP_RETRIEVAL=guide
# AGENT_JHN_WHATSAPP_GUIDE_URL=http://127.0.0.1:8791/guide/chat
# AGENT_JHN_WHATSAPP_GUIDE_TIMEOUT_MS=45000
# AGENT_JHN_WHATSAPP_GATEWAY_URL=http://127.0.0.1:8790
# AGENT_JHN_WHATSAPP_OPENAI_MODEL=gpt-5.6-terra
# AGENT_JHN_WHATSAPP_OPENAI_FALLBACK_MODEL=gpt-4.1-mini
#
# Local smoke (no WhatsApp send):
#   npm run test:agent-jhn-retrieval-smoke
#   npm run smoke:agent-jhn-retrieval -- --mode shadow --limit 3
#   npm run smoke:agent-jhn-retrieval -- --mode librarian --limit 5
