[Unit]
Description=Run Corpus Sleep Cycle Monte Carlo Audit periodically on residual capacity
Documentation=https://github.com/JeanHuguesRobert/cogentia/blob/main/docs/corpus-sleep-cycle-monte-carlo.md

[Timer]
# Runs every 2 hours with a randomized delay to avoid synchronized load spikes
OnCalendar=*-*-* 00/2:15:00 UTC
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
