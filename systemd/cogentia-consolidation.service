[Unit]
Description=Cogentia Weekly Sunday Corpus Consolidation
Documentation=https://github.com/JeanHuguesRobert/cogentia/blob/main/docs/sunday-consolidation-master-plan.md
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/srv/cogentia/repos/cogentia
Environment=NODE_ENV=production
Environment=COGENTIA_REGISTRY=/srv/cogentia/repos/JeanHuguesRobert/.cogentia.json
Nice=10
TimeoutStartSec=15min
ExecStart=/usr/bin/node /srv/cogentia/repos/cogentia/scripts/cogentia.js consolidate --weekly --no-fan-out
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
