[Unit]
Description=Corpus Sleep Cycle - Preemptible Monte Carlo Audit on Residual Capacity
Documentation=https://github.com/JeanHuguesRobert/cogentia/blob/main/docs/corpus-sleep-cycle-monte-carlo.md
After=network.target

[Service]
Type=oneshot
# Must match the UID that owns the registered repo checkouts under
# /srv/cogentia/repos/ (and any symlinked paths outside it, e.g.
# /home/ubuntu/*). The repo_sync phase runs plain `git fetch`/`pull` as
# this user; running as root against non-root-owned checkouts trips
# Git's "detected dubious ownership" guard, and root has no SSH identity
# for private/SSH-remote repos unless separately provisioned.
User=ubuntu
WorkingDirectory=/srv/cogentia/repos/cogentia
Environment=NODE_ENV=production
Environment=COGENTIA_REGISTRY=/srv/cogentia/repos/JeanHuguesRobert/.cogentia.json
# Executes repo sync + Monte Carlo pair audit on qualified residual capacity
# (max 50 pairs, 180s overall budget shared with the new repo_sync phase,
# low CPU priority)
Nice=19
CPUSchedulingPolicy=idle
ExecStart=/usr/bin/node /srv/cogentia/repos/cogentia/scripts/run-corpus-sleep-cycle.js --max-pairs 50 --budget-ms 180000 --json
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
