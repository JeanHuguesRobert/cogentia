# Required before opening collection. These are public notice fields, not secrets.
# Keep collection disabled until the legal entity/controller and data notice are validated.
VITE_WAITLIST_CONTROLLER=CORSE ORGANISANT LA REUNION SUR INTERNET DE COMPETENCES AUTONOMES (C.O.R.S.I.C.A.)
VITE_WAITLIST_PRIVACY_CONTACT=
VITE_WAITLIST_PRIVACY_ADDRESS=1 cours Paoli, F-20250 Corte
VITE_WAITLIST_RETENTION=Au plus tard trois ans après la dernière action de la personne dans la liste
VITE_WAITLIST_PROCESSING_INFO=

# Clé Claude API pour la génération des narratives (présentations)
